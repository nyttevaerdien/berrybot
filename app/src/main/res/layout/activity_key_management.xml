<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/claude_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BerryBot Connection &amp; Keys"
            android:textColor="@color/claude_coral"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tvSetupNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Setup: Enter your Server Host/IP &amp; Username, and add your Public Key to your server's ~/.ssh/authorized_keys before connecting."
            android:textColor="@color/claude_coral"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/key_bg_normal"
            android:padding="8dp"
            android:layout_marginBottom="10dp"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Remote Server Connection:"
            android:textColor="@color/claude_cream"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <EditText
                android:id="@+id/etServerHost"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="3"
                android:hint="Host / IP (e.g. 192.168.1.100)"
                android:textColorHint="@color/claude_cream_dim"
                android:textColor="@color/claude_cream"
                android:textSize="12sp"
                android:background="@drawable/key_bg_normal"
                android:padding="6dp"
                android:singleLine="true"
                android:layout_marginRight="4dp" />

            <EditText
                android:id="@+id/etServerPort"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:hint="Port"
                android:text="2222"
                android:textColorHint="@color/claude_cream_dim"
                android:textColor="@color/claude_cream"
                android:textSize="12sp"
                android:inputType="number"
                android:background="@drawable/key_bg_normal"
                android:padding="6dp"
                android:singleLine="true" />

        </LinearLayout>

        <EditText
            android:id="@+id/etServerUser"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:hint="Username (e.g. root or ubuntu)"
            android:textColorHint="@color/claude_cream_dim"
            android:textColor="@color/claude_cream"
            android:textSize="12sp"
            android:background="@drawable/key_bg_normal"
            android:padding="6dp"
            android:singleLine="true"
            android:layout_marginBottom="10dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/claude_border"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2. SSH Public Key Authentication:"
            android:textColor="@color/claude_cream"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Active OpenSSH Public Key:"
                android:textColor="@color/claude_cream"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnFontMinus"
                android:layout_width="36dp"
                android:layout_height="30dp"
                android:text="A-"
                android:textSize="10sp"
                android:textColor="@color/claude_cream"
                android:background="@drawable/key_bg_normal"
                android:layout_marginRight="4dp" />

            <Button
                android:id="@+id/btnFontPlus"
                android:layout_width="36dp"
                android:layout_height="30dp"
                android:text="A+"
                android:textSize="10sp"
                android:textColor="@color/claude_cream"
                android:background="@drawable/key_bg_normal" />

        </LinearLayout>

        <EditText
            android:id="@+id/etPublicKey"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:background="@drawable/key_bg_normal"
            android:textColor="@color/claude_cream"
            android:textSize="13sp"
            android:typeface="monospace"
            android:gravity="top|left"
            android:padding="6dp"
            android:editable="false"
            android:cursorVisible="false"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvFontLegend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Font: 0 (slashed zero) • O (capital O) • 1 (one) • l (ell) • I (eye)"
            android:textColor="@color/claude_cream_dim"
            android:textSize="9sp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvFingerprint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fingerprint: SHA256:..."
            android:textColor="@color/claude_coral"
            android:textSize="10sp"
            android:typeface="monospace"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnCopyPubkey"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:text="@string/btn_copy_pubkey"
                android:textColor="@color/claude_cream"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/key_bg_pressed"
                android:layout_marginRight="4dp" />

            <Button
                android:id="@+id/btnGenerateKey"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:text="@string/btn_generate_key"
                android:textColor="@color/claude_cream"
                android:textSize="11sp"
                android:background="@drawable/key_bg_normal"
                android:layout_marginLeft="4dp" />

        </LinearLayout>

        <Button
            android:id="@+id/btnPassphraseKey"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:text="Seed Phrase / Passphrase Key"
            android:textColor="@color/claude_cream"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/key_bg_normal"
            android:layout_marginBottom="12dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/claude_border"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Import Existing Private Key:"
            android:textColor="@color/claude_cream"
            android:textSize="12sp"
            android:layout_marginBottom="2dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="(OpenSSH, PKCS#8, or ConnectBot exported key)"
            android:textColor="@color/claude_cream_dim"
            android:textSize="10sp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etPrivateKeyInput"
            android:layout_width="match_parent"
            android:layout_height="75dp"
            android:background="@drawable/key_bg_normal"
            android:hint="@string/hint_paste_private_key"
            android:textColorHint="@color/claude_cream_dim"
            android:textColor="@color/claude_cream"
            android:textSize="13sp"
            android:typeface="monospace"
            android:gravity="top|left"
            android:padding="6dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btnImportKey"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:text="@string/btn_import_key"
                android:textColor="@color/claude_cream"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/key_bg_normal"
                android:layout_marginRight="4dp" />

            <Button
                android:id="@+id/btnClose"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:text="@string/btn_close"
                android:textColor="@color/claude_cream"
                android:textSize="11sp"
                android:background="@drawable/key_bg_normal"
                android:layout_marginLeft="4dp" />

        </LinearLayout>

        <Button
            android:id="@+id/btnConnectNow"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Key Settled — Connect to Server"
            android:textColor="@color/claude_bg"
            android:textStyle="bold"
            android:textSize="12sp"
            android:background="@color/claude_coral"
            android:layout_marginBottom="8dp" />

    </LinearLayout>

</ScrollView>
