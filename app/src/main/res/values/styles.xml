<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.BerryBot" parent="@android:style/Theme.Holo.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/claude_bg</item>
        <item name="android:colorBackground">@color/claude_bg</item>
        <item name="android:textColor">@color/claude_cream</item>
    </style>

    <style name="ClaudeKeyButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/key_bg_selector</item>
        <item name="android:textColor">@color/claude_cream</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:typeface">monospace</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">0dp</item>
        <item name="android:layout_margin">1dp</item>
    </style>
</resources>
